# --- Database ---
POSTGRES_USER=leaduser
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=leads_db
# Optional connection URL override (e.g. Supabase, Neon, or external host):
# DATABASE_URL=postgresql://leaduser:password@host:5432/leads_db

# --- Web App Port ---
APP_PORT=8000

# --- Gemini API (Required for AI Scoring & Value Replies) ---
GEMINI_API_KEY=

# --- Serper API (Optional: Google Search for social leads across Reddit, X, Threads, Telegram) ---
SERPER_API_KEY=

# --- Reddit OAuth2 (Optional: Arctic Shift free archive runs automatically) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SoftwareHouseLeadEngine/1.0

# --- X (Twitter) API v2 (Optional) ---
X_BEARER_TOKEN=

# --- Discord Alert Webhook (Optional: get pinged on qualified 7+ score leads) ---
DISCORD_WEBHOOK_URL=

# --- Worker Settings ---
SYNC_INTERVAL_MINUTES=20
MIN_INTENT_SCORE=7
